# Пример; Go не загружает .env автоматически. Задайте переменную в shell или контейнере.
HTTP_ADDR=127.0.0.1:8080
# Файл с URL подключения вне репозитория; не задавать одновременно DATABASE_URL.
DATABASE_URL_FILE=/absolute/path/outside/repository/api_database_url
AUTH_HMAC_KEY_FILE=/absolute/path/outside/repository/auth_hmac_key
JOB_ENCRYPTION_KEY_FILE=/absolute/path/outside/repository/job_encryption_key
MEDIA_DIR=/absolute/path/outside/repository/private-media
# Production: HTTPS origin without path; AUTH_INSECURE_LOCAL must be unset.
PUBLIC_ORIGIN=http://127.0.0.1:5173
AUTH_INSECURE_LOCAL=1
# Default: do not trust forwarded headers. Set only actual proxy CIDRs in production.
TRUSTED_PROXY_CIDRS=
