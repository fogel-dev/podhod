# Copy outside the checkout. No credentials here.
PODHOD_DOMAIN=app.example.com
PODHOD_STATE_DIR=/var/lib/podhod
PODHOD_SECRETS_DIR=/etc/podhod/secrets
PODHOD_UPSTREAM_SUBNET=172.30.80.0/28
# Supply real images built from the release commit, pinned by digest.
# API/web may use full sha256 image IDs after docker save/load via SSH.
PODHOD_API_IMAGE=
PODHOD_WEB_IMAGE=
PODHOD_PROXY_IMAGE=
PODHOD_DB_IMAGE=
